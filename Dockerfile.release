# Runtime image used by GoReleaser. Local and CI builds use Dockerfile, which
# compiles the operator from source. This file copies the already-built binary.
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
