# Runtime image used by GoReleaser. Local and CI builds use Dockerfile.ui, which
# compiles the UI backend and frontend from source. This file copies the
# already-built binary and static assets.
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY ui-backend /ui-backend
COPY web/ui/dist /ui
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/ui-backend"]
